# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Firebase (Google Sign-In) ---
# Get these from Firebase Console > Project Settings > General > Your apps > Web app config.
# Project: record-my-study (must have Google Sign-In enabled under Authentication > Sign-in method).
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=record-my-study.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=record-my-study
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=record-my-study.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME

# Only this Google account is allowed to log in. Any other account is signed
# out immediately with a "此帳號未被授權" error. Set this to your real Gmail.
NEXT_PUBLIC_ALLOWED_EMAIL=you@example.com

# --- Database (Vercel Postgres / Neon, via Prisma) ---
# Get this from Vercel dashboard after adding the Postgres integration to this
# project (Storage tab > Create Database > Postgres), or from your own Neon
# project connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

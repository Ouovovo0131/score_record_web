// Prisma schema for the exam-tracking dashboard.
// Uses Vercel Postgres (Neon-backed). Set POSTGRES_URL in .env.local / Vercel project settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// A single mock-exam record. userEmail is stored for future multi-user support
// even though this is currently a single-user personal app.
model ExamRecord {
  id            String   @id @default(cuid())
  userEmail     String
  examName      String
  examDate      DateTime
  totalScore    Float    @default(0)
  totalGrade    Float?
  chineseScore  Float?
  chineseGrade  Float?
  englishScore  Float?
  englishGrade  Float?
  mathScore     Float?
  mathGrade     Float?
  mathBScore    Float?
  mathBGrade    Float?
  socialScore   Float?
  socialGrade   Float?
  scienceScore  Float?
  scienceGrade  Float?
  chineseComprehensiveScore Float?
  chineseWritingScore Float?
  englishChoiceScore Float?
  englishMixedScore Float?
  englishTranslationScore Float?
  englishEssayScore Float?
  mathChoiceScore Float?
  mathMixedScore Float?
  mathBChoiceScore Float?
  mathBMixedScore Float?
  scienceChoiceScore Float?
  scienceMixedScore Float?
  socialHistoryScore Float?
  socialGeographyScore Float?
  socialCivicsScore Float?
  physicsScore Float?
  chemistryScore Float?
  biologyScore Float?
  earthScienceScore Float?
  physicsNonChoiceScore Float?
  chemistryNonChoiceScore Float?
  biologyNonChoiceScore Float?
  earthScienceNonChoiceScore Float?
  chineseTopGrade Float?
  chineseFrontGrade Float?
  chineseAverageGrade Float?
  chineseBackGrade Float?
  chineseBottomGrade Float?
  englishTopGrade Float?
  englishFrontGrade Float?
  englishAverageGrade Float?
  englishBackGrade Float?
  englishBottomGrade Float?
  mathTopGrade Float?
  mathFrontGrade Float?
  mathAverageGrade Float?
  mathBackGrade Float?
  mathBottomGrade Float?
  mathBTopGrade Float?
  mathBFrontGrade Float?
  mathBAverageGrade Float?
  mathBBackGrade Float?
  mathBBottomGrade Float?
  scienceTopGrade Float?
  scienceFrontGrade Float?
  scienceAverageGrade Float?
  scienceBackGrade Float?
  scienceBottomGrade Float?
  socialTopGrade Float?
  socialFrontGrade Float?
  socialAverageGrade Float?
  socialBackGrade Float?
  socialBottomGrade Float?
  classRank Float?
  classTotal Float?
  schoolRank Float?
  schoolTotal Float?
  overallRank Float?
  overallTotal Float?
  reviewTags    Json     @default("[]")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userEmail])
}

// A single English practice record (妙妙卷 / 克漏字 / 好好學). Category
// scores are nullable because some categories are unavailable by practice type.
model EnglishRecord {
  id               String   @id @default(cuid())
  userEmail        String
  practiceType     String
  practiceDate     DateTime
  practiceName     String
  totalScore        Float?
  questionsAttempted Int?
  questionsCorrect   Int?
  vocabularyScore   Float?
  clozeScore        Float?
  contextScore      Float?
  structureScore    Float?
  readingScore      Float?
  mixedScore        Float?
  translationScore Float?
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  questions         EnglishQuestion[]

  @@index([userEmail])
}

// Single-row-per-user goal configuration.
model Goal {
  id                    String   @id @default(cuid())
  userEmail             String   @unique
  goalName              String
  targetTotalGrade      Float?
  targetChineseGrade    Float?
  targetEnglishGrade    Float?
  targetMathGrade       Float?
  targetMathBGrade      Float?
  targetScienceGrade    Float?
  targetSocialGrade     Float?
  targetEnglishAccuracy Float?
  targetDate            DateTime? @db.Date
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// One row per day the user studied. A missing row means "did not study".
model StudyLog {
  id        String   @id @default(cuid())
  userEmail String
  studyDate DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userEmail, studyDate])
}

model StudyTask {
  id        String   @id @default(cuid())
  userEmail String
  title     String
  subject   String   @default("other")
  kind      String   @default("review")
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String   @default("")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail, startDate])
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String   @default("")
  createdAt DateTime @default(now())
}

model UserProfile {
  id        String   @id @default(cuid())
  email     String   @unique
  track     String
  updatedAt DateTime @updatedAt
}

model StudySession {
  id        String   @id @default(cuid())
  userEmail String
  studyDate DateTime @db.Date
  minutes   Int
  subject   String   @default("other")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail, studyDate])
}

model EnglishQuestion {
  id                String        @id @default(cuid())
  userEmail         String
  englishRecordId   String?
  questionIdentifier String      @default("")
  questionContent   String        @default("")
  userAnswer        String        @default("")
  correctAnswer     String        @default("")
  errorCategory     String        @default("other")
  correctionNotes   String        @default("")
  reviewStatus      String        @default("not_reviewed")
  lastReviewedAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  englishRecord     EnglishRecord? @relation(fields: [englishRecordId], references: [id], onDelete: SetNull)
  reviewHistory     EnglishQuestionReview[]

  @@index([userEmail, reviewStatus])
  @@index([userEmail, errorCategory])
}

model EnglishQuestionReview {
  id                String          @id @default(cuid())
  englishQuestionId String
  reviewedAt        DateTime        @default(now())
  note              String          @default("")
  question          EnglishQuestion @relation(fields: [englishQuestionId], references: [id], onDelete: Cascade)

  @@index([englishQuestionId, reviewedAt])
}

model Weakness {
  id               String   @id @default(cuid())
  userEmail        String
  title            String
  subject          String   @default("other")
  topic            String   @default("")
  discoveredAt     DateTime @db.Date
  errorDescription String   @default("")
  status           String   @default("not_reviewed")
  reviewNotes      String   @default("")
  lastReviewedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reviewHistory    WeaknessReview[]

  @@index([userEmail, status])
  @@index([userEmail, discoveredAt])
}

model WeaknessReview {
  id         String   @id @default(cuid())
  weaknessId String
  reviewedAt DateTime @default(now())
  note       String   @default("")
  weakness   Weakness @relation(fields: [weaknessId], references: [id], onDelete: Cascade)

  @@index([weaknessId, reviewedAt])
}